PORT=8080
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
WEB_DIST_DIR=apps/web/dist
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_API_BASE_URL=https://gitlab.example.com/api/v4
GITLAB_TOKEN=
# The local .env may use these equivalent names.
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB__PERSONAL_ACCESS_TOKEN=
# Optional GitLab OAuth application for per-user workbench login.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Optional exact callback override. Leave unset for local dev; dev.sh derives it from the selected Web Origin.
# GITLAB_OAUTH_REDIRECT_URI=
GITLAB_OAUTH_SCOPE=api
# Reserved Jira Data Center OAuth 1.0a settings. The current personal entry uses
# a Jira username plus password/Token; these settings can be enabled later.
JIRA_OAUTH_CONSUMER_KEY=
JIRA_OAUTH_PRIVATE_KEY=
JIRA_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/jira/oauth/callback
GITLAB_WEBHOOK_SECRET=
# Product login account; keep the password only in the deployment environment.
FRONTEND_PILOT_LOGIN_USERNAME=
FRONTEND_PILOT_LOGIN_PASSWORD=
# Optional administrator password; when omitted, pilot-admin uses the product password above.
FRONTEND_PILOT_ADMIN_PASSWORD=
# Optional key used to encrypt passwords that administrators may display; defaults to REVIEW_SERVICE_TOKEN.
FRONTEND_PILOT_PASSWORD_DISPLAY_KEY=
# Server-side API protection. Set AUTH_SESSION_SECRET to a separate stable secret
# in production; it falls back to REVIEW_SERVICE_TOKEN for compatibility.
REVIEW_SERVICE_TOKEN=
AUTH_SESSION_SECRET=
# Product and inspection browser sessions: rolling idle TTL plus an absolute TTL.
AUTH_SESSION_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_SESSION_REFRESH_WINDOW_SECONDS=86400
INSPECTION_SESSION_IDLE_TTL_SECONDS=604800
INSPECTION_SESSION_ABSOLUTE_TTL_SECONDS=2592000
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_THINKING_MODE=adaptive
CLAUDE_THINKING_BUDGET_TOKENS=4096
CLAUDE_MAX_TOKENS=4096
CLAUDE_MAX_RETRIES=2
# Maximum time without a Claude SDK event before an assistant run is stopped.
ASSISTANT_IDLE_TIMEOUT_MS=180000
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_WORKSPACE_DIR=var/claude-cli-workspaces
REVIEW_CONCURRENCY=2
INSPECTION_AI_CONCURRENCY=2
REVIEW_MAX_DIFF_BYTES=300000
REVIEW_RULES_DIR=config/skills
REVIEW_PROFILE_CONFIG=config/review-profiles.json
INSPECTION_RULES_DIR=config/skills/inspection
INSPECTION_PROFILE_CONFIG=config/inspection-profiles.json
REVIEW_DATABASE_PATH=var/frontend-pilot.sqlite
REVIEW_DRY_RUN=true

# Optional Jira Server / Data Center connection.
JIRA_BASE_URL=https://jira.example.com
JIRA_API_BASE_URL=https://jira.example.com/rest/api/2
JIRA_PROJECT_KEY=DEMO
JIRA_USERNAME=
JIRA_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
