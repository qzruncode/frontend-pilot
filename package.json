{
  "name": "frontend-pilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm --workspace apps/web run dev",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm --workspace apps/web run build",
    "test": "vitest run",
    "check": "npm run check:api && npm --workspace apps/web run typecheck",
    "check:api": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.3.1",
    "croner": "^10.0.1",
    "fastify": "^5.4.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
